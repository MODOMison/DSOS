# Copy this file to backend/.env and fill in values.
# DSOS works fully without these — they only unlock optional features.

# Optional: Anthropic API key enables the Shadows AI panel.
# Get one at https://console.anthropic.com — requires a paid account.
ANTHROPIC_API_KEY=

# Optional: NVD API key raises rate limits for CVE Oracle (free, request at nvd.nist.gov/developers).
NVD_API_KEY=
