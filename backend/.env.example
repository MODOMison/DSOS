# ---- DSOS backend env ----
# Copy to backend/.env and fill in. Never commit the real .env.

# Server
PORT=4000
APP_URL=http://localhost:5173

# Session cookie signing. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-48-byte-hex-string

# SQLite file path. Relative to the backend/ working directory.
DATABASE_URL=./dsos.db

# Stripe — required to enable the /api/billing/* endpoints.
# Get these from https://dashboard.stripe.com (test mode is fine for dev).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRO_PRICE_ID=price_...
# Set this after running `stripe listen` (see README) or from the dashboard
# webhook endpoint you create.
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Anthropic key the *platform* will use for Pro users who don't
# bring their own. Leave blank to force BYO key for everyone.
PLATFORM_ANTHROPIC_KEY=

# Legacy: only used as a fallback during development if neither the user nor
# PLATFORM_ANTHROPIC_KEY is set. Can stay blank in production.
ANTHROPIC_API_KEY=
